# Build output
dist/
*.tsbuildinfo

# Release tarballs from `npm run release`. The artifact belongs on a GitHub
# release, not in git history, where it would be a 96 KB binary per version
# that nothing can ever remove.
*.tgz

# Dependencies
node_modules/

# Pipeline run output (artifacts, sessions, logs, checkpoints)
runs/
examples/**/runs/
examples/**/corpus/text/

# Test / tooling
coverage/
.vitest/
*.log

# Local environment
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
