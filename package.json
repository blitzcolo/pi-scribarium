{
  "name": "pi-scribarium",
  "version": "0.3.0",
  "private": true,
  "description": "Multi-agent orchestration for academic writing, built on the Pi Agent SDK",
  "keywords": [
    "pi-package",
    "agent",
    "multi-agent",
    "orchestration",
    "academic-writing",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "scribarium": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "agents",
    "pipelines",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "release": "npm run typecheck && npm test && npm pack"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "~0.84.1",
    "typebox": "1.3.7",
    "unpdf": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blitzcolo/pi-scribarium.git"
  },
  "bugs": {
    "url": "https://github.com/blitzcolo/pi-scribarium/issues"
  },
  "homepage": "https://github.com/blitzcolo/pi-scribarium#readme",
  "author": "blitzcolo"
}
