{
  "name": "pi-scribarium",
  "version": "0.1.0",
  "description": "Multi-agent orchestration for academic writing, built on the Pi Agent SDK",
  "keywords": [
    "pi-package",
    "agent",
    "multi-agent",
    "orchestration",
    "academic-writing",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "scholarly": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "agents",
    "pipelines",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "~0.84.1",
    "unpdf": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
